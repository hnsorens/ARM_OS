const std = @import("std");

pub fn build(b: *std.Build) void {
    // 1. Setup target and optimization
    const target = b.resolveTargetQuery(.{
        .cpu_arch = .aarch64,
        .os_tag = .uefi,
        .abi = .msvc, 
    });
    const optimize = b.standardOptimizeOption(.{});

    // 2. Compile Zig Bootloader
    const exe_name = if (target.result.cpu.arch == .aarch64) "bootaa64" else "bootarm";
    const bootloader = b.addExecutable(.{
        .name = exe_name,
        .root_module = b.createModule(.{
            .root_source_file = b.path("main.zig"),
            .target = target,
            .optimize = optimize,
        }),
    });
    
    // Extract the artifact path emitted by Zig compilation
    const boot_elf = bootloader.getEmittedBin();

    // 3. Disk Provisioning Steps
    const img_name = "disk.img";

    // Step A: Allocate a raw 128MB sparse block file
    const truncate_cmd = b.addSystemCommand(&.{ "truncate", "-s", "128M", img_name });
    
    // Step B: Create a fresh GPT partition layout
    const sgdisk_init = b.addSystemCommand(&.{ "sgdisk", "-o", img_name });
    sgdisk_init.step.dependOn(&truncate_cmd.step);

    // Step C: Carve out the primary EFI partition (Type ef00)
    const sgdisk_part = b.addSystemCommand(&.{ "sgdisk", "-n", "1:2048:262110", "-t", "1:ef00", img_name });
    sgdisk_part.step.dependOn(&sgdisk_init.step);

    // Step D: Format the EFI system partition slice using mtools (1M offset allocation)
    const mformat_cmd = b.addSystemCommand(&.{ "mformat", "-i", img_name ++ "@@1M", "-F", "-H", "2048", "-c", "1", "-v", "ESP", "::" });
    mformat_cmd.step.dependOn(&sgdisk_part.step);

    // Step E: Create default systemic layout paths (Ensuring double colons '::')
    const mmd_efi = b.addSystemCommand(&.{ "mmd", "-i", img_name ++ "@@1M", "::/EFI" });
    mmd_efi.step.dependOn(&mformat_cmd.step);

    const mmd_boot = b.addSystemCommand(&.{ "mmd", "-i", img_name ++ "@@1M", "::/EFI/BOOT" });
    mmd_boot.step.dependOn(&mmd_efi.step);

    const mmd_mods = b.addSystemCommand(&.{ "mmd", "-i", img_name ++ "@@1M", "::/modules" });
    mmd_mods.step.dependOn(&mmd_boot.step);

    // Step F: Inject your newly compiled bootloader (FIXED: Uses '::/EFI/BOOT/BOOTAA64.EFI')
    const mcopy_boot = b.addSystemCommand(&.{ "mcopy", "-i", img_name ++ "@@1M" });
    mcopy_boot.addFileArg(boot_elf);
    mcopy_boot.addArgs(&.{"::/EFI/BOOT/BOOTAA64.EFI"});
    mcopy_boot.step.dependOn(&mmd_mods.step);
    mcopy_boot.step.dependOn(&bootloader.step); 

    // Optional conditional parsing: Inject kernel.ini if it is sitting in the directory
    const mcopy_ini = b.addSystemCommand(&.{ "sh", "-c", "if [ -f kernel.ini ]; then mcopy -i disk.img@@1M kernel.ini ::/kernel.ini; fi" });
    mcopy_ini.step.dependOn(&mcopy_boot.step);

    // Establish a unified build endpoint step for image creation
    const image_step = b.step("image", "Assemble the raw segmented UEFI disk image file");
    image_step.dependOn(&mcopy_ini.step);

    // 4. Emulate Hardware Architecture
    const run_cmd = b.addSystemCommand(&.{ "qemu-system-aarch64" });
    run_cmd.addArgs(&.{
        "-m", "16G",
        "-cpu", "cortex-a72",
        "-smp", "4",
        "-M", "virt,gic-version=3",
        "-accel", "tcg,thread=multi",
        "-bios", "/usr/share/edk2/aarch64/QEMU_EFI.fd",
        "-drive", "file=disk.img,format=raw,if=none,id=d0",
        "-device", "virtio-blk-device,drive=d0",
        "-mem-prealloc",
        "-gdb", "tcp::1234",
        "-nographic",
    });

    run_cmd.step.dependOn(image_step);

    const run_step = b.step("run", "Compile, provision disk.img, and execute QEMU simulation environment");
    run_step.dependOn(&run_cmd.step);
}

